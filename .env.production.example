NODE_ENV=production
HOST=0.0.0.0
PORT=8787

REPOSITORY_DRIVER=cloudbase
SAFETY_DRIVER=wechat
CLOUDBASE_ENV_ID=replace-with-cloudbase-env-id
USER_ID_HMAC_SECRET=replace-with-at-least-32-random-characters
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret

AI_DRIVER=pi
PI_PROVIDER=deepseek
PI_MODEL_ID=deepseek-v4-flash
PI_AUTH_MODE=api-key
PI_API_KEY=replace-with-server-side-key
PI_BASE_URL=
PUBLIC_MODEL_NAME=DeepSeek V4 Flash
PUBLIC_MODEL_PROVIDER=深度求索
PUBLIC_MODEL_REGISTRATION_NUMBER=replace-with-approved-public-number
PROMPT_VERSION=reflection-v1

CONSENT_VERSION=2026-08-07.v1
PRIVACY_POLICY_VERSION=2026-08-07.v1
READING_TIMEOUT_MS=25000
SESSION_TTL_HOURS=24
DAILY_REFLECTION_LIMIT=1

CARD_ASSET_BASE_URL=https://replace-with-approved-domain.example/assets
PUBLIC_PRIVACY_URL=https://replace-with-approved-domain.example/privacy
PUBLIC_TERMS_URL=https://replace-with-approved-domain.example/terms
PUBLIC_FEEDBACK_URL=https://replace-with-approved-domain.example/feedback
